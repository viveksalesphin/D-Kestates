# D&K Estates — environment configuration
# Copy this file to `.env.local` and fill in real values before launch.
# Values prefixed with NEXT_PUBLIC_ are exposed to the browser.

# --- Contact (used across the site; see src/lib/config.ts) ---
# E.164 format for tel: links, e.g. +919812345678
NEXT_PUBLIC_CONTACT_PHONE=
# Human-friendly display, e.g. +91 98123 45678
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=
# WhatsApp number (digits only or +country). Falls back to NEXT_PUBLIC_CONTACT_PHONE.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Business email
NEXT_PUBLIC_CONTACT_EMAIL=contact@dkestates.co.in

# --- Social (optional; footer links appear only if set) ---
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# --- Analytics / tracking (optional; scripts load only when set) ---
# Meta Pixel ID (for Facebook/Instagram ads)
NEXT_PUBLIC_META_PIXEL_ID=
# Google Analytics 4 Measurement ID, e.g. G-XXXXXXX
NEXT_PUBLIC_GA_ID=

# --- Lead handling (server-side only) ---
# Optional webhook/CRM endpoint the /api/lead handler forwards submissions to.
LEAD_WEBHOOK_URL=
